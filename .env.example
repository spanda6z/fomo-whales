# ===========================================
# Fomo Whales — Environment Variables
# Copy to .env.local (or .env) and fill values.
# NEVER commit real secrets.
# ===========================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/FomoWhalesBot

# Database (Phase 2+)
DATABASE_URL=postgresql://user:password@localhost:5432/fomo_whales

# Redis (Phase 3+)
REDIS_URL=redis://localhost:6379

# Telegram Bot (Phase 2+)
TELEGRAM_BOT_TOKEN=
TELEGRAM_FREE_CHANNEL_ID=
TELEGRAM_WEBHOOK_SECRET=

# Payment Provider (Phase 4+)
PAYMENT_PROVIDER=placeholder
PAYMENT_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_CURRENCY=USD

# Price Provider (Phase 3+)
PRICE_PROVIDER=dexscreener
PRICE_API_KEY=

# Admin
ADMIN_SECRET=

# Logging
LOG_LEVEL=info
